{
  "data": {
    "dataset_path": "/content/drive/MyDrive/dataset",
    "train_transaction": "train_transaction.csv",
    "train_identity": "train_identity.csv",
    "test_transaction": "test_transaction.csv",
    "test_identity": "test_identity.csv",
    "test_size": 0.2,
    "val_size": 0.2,
    "random_state": 42,
    "partition_strategy": "time_based",
    "num_banks": 3
  },
  "model": {
    "hidden_layers": [
      256,
      128,
      64
    ],
    "dropout_rate": 0.3,
    "activation": "relu",
    "batch_norm": true,
    "learning_rate": 0.001,
    "batch_size": 512,
    "local_epochs": 5,
    "weight_decay": "1e-5",
    "class_weight_enabled": true,
    "smote_enabled": false,
    "personalization_enabled": false,
    "personalization_epochs": 1,
    "personalization_lr_factor": 10,
    "balance_classes": true,
    "augment_minority": false
  },
  "federated_learning": {
    "num_rounds": 50,
    "clients_per_round": 3,
    "min_fit_clients": 2,
    "min_evaluate_clients": 2,
    "min_available_clients": 3,
    "strategy": "FedAvg",
    "fedprox_proximal_mu": 0.01
  },
  "differential_privacy": {
    "enabled": false,
    "noise_multiplier": 1.1,
    "max_grad_norm": 1.0,
    "target_epsilon": 8.0,
    "target_delta": "1e-5",
    "accountant_mode": "rdp"
  },
  "experiment": {
    "name": "privfed_fraud_detection",
    "seed": 42,
    "device": "auto",
    "log_level": "INFO",
    "save_checkpoints": true,
    "checkpoint_frequency": 10,
    "results_dir": "results",
    "models_dir": "models",
    "logs_dir": "logs",
    "experiments_dir": "experiments"
  },
  "api": {
    "host": "0.0.0.0",
    "port": 8000,
    "reload": true,
    "allow_origins": [
      "*"
    ],
    "allow_credentials": true,
    "allow_methods": [
      "*"
    ],
    "allow_headers": [
      "*"
    ]
  },
  "debug": {
    "score_sample_logging": true,
    "pooled_score_aggregation": true,
    "max_score_samples": 2000
  }
}